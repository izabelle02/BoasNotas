<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BoasNotas" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DDE1FF</item>
        <item name="colorOnPrimaryContainer">#00105C</item>
        <item name="colorSecondaryContainer">#DDE1FF</item>
        <item name="colorOnSecondaryContainer">#00105C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="BarButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/icon</item>
    </style>

    <style name="ToolButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/tool_bg</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/tool_tint</item>
    </style>
</resources>
